XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_SWAP_API_BASE=https://api.jup.ag/swap/v2
METEORA_POOLS_URL=https://dlmm.datapi.meteora.ag/pools
PYTH_HERMES_URL=https://hermes.pyth.network/v2/updates/price/latest
PYTH_HERMES_API_KEY=
JUPITER_API_KEY=
ENABLE_LIVE_TRADING=
CLAWPUMP_API_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Platform fee / surcharge destination (Solana pubkey). Required before live platform fee splits.
PLATFORM_TREASURY_WALLET=
NEXT_PUBLIC_PLATFORM_TREASURY_WALLET=

# Meteora DBC PoolConfig pubkeys (mainnet). Required for Equity Standard/Momentum/Deep Book launches.
# Create via Meteora Invent / DBC SDK — quote mint must be the xStock you launch against.
METEORA_DBC_CONFIG=
METEORA_DBC_CONFIG_LINEAR=
METEORA_DBC_CONFIG_EXPONENTIAL=
METEORA_DBC_CONFIG_FLAT=

# Meteora DAMM v2 config pubkey for DBC → DAMM graduation/migration. Required for migration modal.
METEORA_DAMM_V2_CONFIG=
