XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2
# Server-side only. The browser reaches Solana through /api/rpc, so a keyed URL (e.g. Helius) never ships to clients.
# The public endpoint works but rate-limits holder lookups (getTokenLargestAccounts) heavily.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_SWAP_API_BASE=https://api.jup.ag/swap/v2
METEORA_POOLS_URL=https://dlmm.datapi.meteora.ag/pools
PYTH_HERMES_URL=https://hermes.pyth.network/v2/updates/price/latest
PYTH_HERMES_API_KEY=
JUPITER_API_KEY=
ENABLE_LIVE_TRADING=
CLAWPUMP_API_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Durable storage (accounts, receipts, alerts, launched-token registry, uploaded artwork).
# Required on Vercel/serverless — without it those features return a clean "storage not configured" error.
# Local dev falls back to .data/*.json. The Vercel KV aliases KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meteora DBC PoolConfigs per xStock and curve style (created by scripts/create-meteora-configs.mjs).
# The script prints this exact line after a broadcast:
METEORA_DBC_CONFIGS=
# Legacy single-config forms (treated as the "standard" curve): METEORA_DBC_CONFIG_NVDAx=..., METEORA_DBC_CONFIG_BY_MINT={"<mint>":"<config>"}

# Meteora DAMM v2 config pubkey for DBC → DAMM graduation/migration. Required for migration modal.
METEORA_DAMM_V2_CONFIG=
